# Required for Docker Compose. Use a long random value.
SOROSLO_ADMIN_TOKEN=replace-with-a-long-random-token

# Default host exposure remains loopback-only.
SOROSLO_BIND_ADDRESS=127.0.0.1
SOROSLO_DASHBOARD_PORT=3000
SOROSLO_API_PORT=3001

# Set to your externally reachable dashboard URL when applicable.
SOROSLO_DASHBOARD_URL=http://127.0.0.1:3000

# Set true only when the dashboard is served over HTTPS.
SOROSLO_COOKIE_SECURE=false

# Private/loopback webhook targets are rejected by default.
SOROSLO_ALLOW_PRIVATE_WEBHOOKS=false

SOROSLO_RUNNER_CONCURRENCY=4
SOROSLO_RUNNER_TICK_MS=5000
